{
  "name": "@shiguri/textlint-plugin-typst",
  "version": "0.1.0",
  "description": "textlint plugin for Typst powered by MoonBit and moonbitlang/typst",
  "license": "MIT",
  "author": "shiguri",
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build:mbt": "moon build --target js --release",
    "build:wasm": "moon build --target wasm-gc --release",
    "build": "vp run build:mbt && vp pack",
    "fmt": "moon fmt && vp fmt",
    "check": "moon fmt --check && moon check --target js --no-mbti && vp run build:mbt && vp check",
    "test:mbt": "moon test --target js",
    "test:js": "vp run build:mbt && vp test run",
    "test": "vp run test:mbt && vp run test:js",
    "verify": "vp run check && vp pack && vp run test:mbt && vp test run"
  },
  "devDependencies": {
    "@textlint/ast-node-types": "^16.1.2",
    "@textlint/ast-tester": "^16.1.2",
    "@textlint/kernel": "^16.1.2",
    "@textlint/types": "^16.1.2",
    "sentence-splitter": "^5.1.0",
    "textlint": "^16.1.2",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-no-todo": "^2.0.1",
    "vite-plus": "catalog:"
  }
}
